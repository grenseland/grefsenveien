<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Grefsenveien.Tv" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/tv_bg</item>
        <item name="colorPrimary">@color/tv_accent</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="TvActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">120dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/tv_text</item>
        <item name="android:background">@drawable/tv_action_button</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:drawablePadding">10dp</item>
    </style>
</resources>
