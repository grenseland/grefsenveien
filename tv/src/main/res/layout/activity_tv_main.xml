<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg"
    android:orientation="vertical"
    android:paddingStart="36dp"
    android:paddingTop="18dp"
    android:paddingEnd="36dp"
    android:paddingBottom="18dp"
    tools:deviceIds="tv"
    tools:ignore="Overdraw">

    <LinearLayout
        android:id="@+id/toolbarRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tv_toolbar_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:text="@string/app_name"
            android:textColor="@color/tv_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnGarage"
            style="@style/TvActionButton"
            android:layout_marginEnd="10dp"
            android:drawableStart="@drawable/ic_material_garage_door"
            android:nextFocusDown="@id/dashboard"
            android:text="@string/tv_garage" />

        <Button
            android:id="@+id/btnGaragePlus"
            style="@style/TvActionButton"
            android:layout_marginEnd="10dp"
            android:nextFocusDown="@id/dashboard"
            android:text="@string/tv_garage_plus" />

        <Button
            android:id="@+id/btnGate"
            style="@style/TvActionButton"
            android:layout_marginEnd="16dp"
            android:drawableStart="@drawable/ic_material_outdoor_garden"
            android:nextFocusDown="@id/dashboard"
            android:text="@string/tv_gate" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/tv_text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLoggedInAs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/tv_not_logged_in"
            android:textColor="@color/tv_text_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnLogout"
            style="@style/TvActionButton"
            android:minWidth="110dp"
            android:nextFocusDown="@id/dashboard"
            android:text="@string/tv_logout"
            android:textSize="13sp" />
    </LinearLayout>

    <com.pixelspore.grefsenveien.tv.TvDashboardView
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:focusable="false" />

</LinearLayout>
